DB_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
ADMIN_INITIAL_PASSWORD=CHANGE_ME
APP_PUBLIC_URL=http://localhost:8080
HTTP_BIND=127.0.0.1
